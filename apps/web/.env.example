# Server-side URL of the API (Server Components, dashboard proxy, sign-in)
API_URL=http://localhost:3333/api/v1
# Browser-side URL of the API (contact form). Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
# Public URL of this site (canonical URLs, hreflang, sitemap, Open Graph). Inlined at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Must equal the API's REVALIDATE_SECRET
REVALIDATE_SECRET=change-me-revalidate-0123456789abcdef0123
