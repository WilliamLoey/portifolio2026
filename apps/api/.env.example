# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
# Public origin of this API (image URLs with local storage, OpenAPI server URL)
PUBLIC_API_URL=http://localhost:3333
# Browser origins allowed by CORS (the website, for the contact form). Comma-separated.
CORS_ORIGINS=http://localhost:3000
# Proxies in front of the API: 0 locally, 1 on Vercel
TRUST_PROXY=0

# ─── Database ─────────────────────────────────────────────────────────────────
# Docker:  postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public
# PGlite (no Docker, `npm run db:lite`): postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
# Neon:    DATABASE_URL = pooled connection string, DIRECT_URL = direct one (used by migrations)
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public
DIRECT_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public
# Connections per instance: 5 on serverless, 1 with PGlite
DATABASE_POOL_MAX=5

# ─── Security ─────────────────────────────────────────────────────────────────
# Dashboard sessions expire after this many hours
SESSION_TTL_HOURS=168
# Salt for hashing visitor IPs. Generate: openssl rand -base64 48
IP_HASH_SALT=change-me-0123456789abcdef0123456789abcdef

# ─── Images ───────────────────────────────────────────────────────────────────
# local       → saved in UPLOAD_DIR, served at /uploads (development, Docker)
# vercel-blob → on Vercel (Storage → Blob adds BLOB_READ_WRITE_TOKEN)
# cloudinary  → any host (CLOUDINARY_* keys)
STORAGE_DRIVER=local
STORAGE_FOLDER=portfolio
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=4
BLOB_READ_WRITE_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (contact form) ─────────────────────────────────────────────────────
# log    → prints emails to the console (development only)
# smtp   → Mailpit locally (localhost:1025, SMTP_SECURE=false) or Gmail with an app password
# resend → production (RESEND_API_KEY). Without a verified domain, use onboarding@resend.dev
#          as MAIL_FROM: Resend then only delivers to your own account address, which is MAIL_TO.
MAIL_DRIVER=log
MAIL_FROM="Portfolio <onboarding@resend.dev>"
MAIL_TO=you@example.com
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Website revalidation ─────────────────────────────────────────────────────
# Called after every publish so the static pages rebuild. Required in production.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Same value in the web project. Generate: openssl rand -base64 48
REVALIDATE_SECRET=change-me-revalidate-0123456789abcdef0123
